{
  "manifest_version": 2,
  "name": "GitHub PR Merge Method",
  "version": "1.0.0",
  "description": "Set the merge method to your default method when loading the main page of a GitHub pull request.",
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Merge Method Settings"
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
