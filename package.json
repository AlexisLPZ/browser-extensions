{
  "name": "browser-extensions",
  "version": "1.0.0",
  "description": "Browser extensions",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . && htmlhint **/*.html",
    "lint:fix": "eslint . --fix",
    "lint:html": "htmlhint **/*.html",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexisLPZ/browser-extensions.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlexisLPZ/browser-extensions/issues"
  },
  "homepage": "https://github.com/AlexisLPZ/browser-extensions#readme",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "htmlhint": "^1.8.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4"
  }
}
